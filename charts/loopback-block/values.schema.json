{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ]
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/dev/loop[0-9]+$"
          },
          "file": {
            "type": "string",
            "pattern": "^/var/lib/loopback-block/[A-Za-z0-9._/-]+$"
          },
          "sizeMB": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "path",
          "file",
          "sizeMB"
        ]
      }
    }
  },
  "required": [
    "image",
    "devices"
  ]
}
